# Vibeflow - custom LLM endpoint (OpenAI / Anthropic compatible gateway)
# Copy this file to ".env" and fill in your own values.
# ".env" is git-ignored and never committed.
#
# Most image-capable text models plug in, as long as they expose a compatible
# gateway. Two common cases:
#   - Anthropic-compatible (Claude Code / this toolchain default):
#       use the provider's /anthropic gateway URL (e.g. DeepSeek's).
#   - OpenAI-compatible vision model (GPT-4o / Gemini / Qwen-VL / local llama / ...):
#       point LLM_BASE_URL at an OpenAI->Anthropic gateway (litellm / one-api).
#
# Required:
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat
#
# Optional per-tier overrides (leave blank to use LLM_MODEL everywhere):
# LLM_OPUS_MODEL=
# LLM_SONNET_MODEL=
# LLM_HAIKU_MODEL=
# LLM_SUBAGENT_MODEL=
#
# Optional: reasoning effort for Claude-family gateways (omit for non-Claude models)
# LLM_EFFORT=max

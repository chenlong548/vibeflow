  "subtitles": [
    { "zh": "它们有一个共同的名字：信息。", "en": "They all share one name: information.", "t_in": 0.62, "t_out": 4.0, "punch": false },
    { "zh": "信息，该怎么「称重」？", "en": "How do you weigh information?", "t_in": 5.1, "t_out": 7.45, "punch": false },
    { "zh": "答案，在 1948 年的论文里。", "en": "The answer: a 1948 paper.", "t_in": 7.8, "t_out": 11.0, "punch": false },
    { "zh": "作者：克劳德 · 香农。", "en": "Author: Claude E. Shannon.", "t_in": 11.2, "t_out": 15.0, "punch": false },
    { "zh": "通信只做一件事：搬运。", "en": "Communication just moves messages.", "t_in": 15.5, "t_out": 19.8, "punch": false },
    { "zh": "从信源到目的地，五站接力。", "en": "Five stations, source to destination.", "t_in": 20.1, "t_out": 24.4, "punch": false },
    { "zh": "意义被剥掉，剩下的可被测量。", "en": "Strip the meaning — measure what's left.", "t_in": 30.8, "t_out": 35.4, "punch": false },
    { "zh": "测量的单位，叫比特。", "en": "The unit is the bit.", "t_in": 38.4, "t_out": 42.5, "punch": false },
    { "zh": "1 bit = 一次抛硬币。", "en": "1 bit = one coin flip.", "t_in": 44.0, "t_out": 48.0, "punch": false },
    { "zh": "两个可能消灭一个，正好一比特。", "en": "Kill one of two options: one bit.", "t_in": 48.3, "t_out": 52.8, "punch": false },
    { "zh": "信息 = 消灭不确定的问题数。", "en": "Information = questions to kill doubt.", "t_in": 53.6, "t_out": 58.2, "punch": false },
    { "zh": "一条反直觉的规则：", "en": "A counter-intuitive rule:", "t_in": 62.2, "t_out": 66.5, "punch": false },
    { "zh": "越意外，信息量越大。", "en": "The more surprise, the more information.", "t_in": 67.0, "t_out": 71.5, "punch": false },
    { "zh": "太阳升起 ≈ 0 比特。", "en": "Sunrise ≈ 0 bits.", "t_in": 72.4, "t_out": 77.0, "punch": false },
    { "zh": "中奖号码：一句顶一万句。", "en": "Winning numbers: priceless.", "t_in": 77.5, "t_out": 82.3, "punch": false },
    { "zh": "平均意外程度，叫「熵」。", "en": "Average surprise is called entropy.", "t_in": 86.0, "t_out": 91.0, "punch": false },
    { "zh": "结果越均匀，熵越大。", "en": "Uniformer outcomes, higher entropy.", "t_in": 91.3, "t_out": 96.0, "punch": false },
    { "zh": "熵越大，需要的比特越多。", "en": "Higher entropy needs more bits.", "t_in": 96.6, "t_out": 101.2, "punch": false },
    { "zh": "数字世界的地基，就是它。", "en": "This is the bedrock of the digital world.", "t_in": 101.9, "t_out": 106.3, "punch": false },
    { "zh": "香农拿英文做实验：", "en": "Shannon ran it on English:", "t_in": 109.8, "t_out": 114.5, "punch": false },
    { "zh": "每字母 ≈ 4.7 比特（按字符统计）。", "en": "≈ 4.7 bits per letter (by character).", "t_in": 115.1, "t_out": 120.0, "punch": false },
    { "zh": "近一半是冗余——猜得到的免费。", "en": "Nearly half is redundancy — free.", "t_in": 120.4, "t_out": 125.2, "punch": false },
    { "zh": "冗余不是废话，是抗噪的护甲。", "en": "Redundancy is noise armor.", "t_in": 125.7, "t_out": 130.3, "punch": false },
    { "zh": "还有一条管道定律：", "en": "And a pipe law:", "t_in": 133.6, "t_out": 138.3, "punch": false },
    { "zh": "C = log₂(1 + S/N)。", "en": "C = log2(1 + S/N).", "t_in": 138.9, "t_out": 143.7, "punch": false },
    { "zh": "不超容量，错误趋近于零。", "en": "Stay under it — errors vanish.", "t_in": 144.2, "t_out": 148.9, "punch": false },
    { "zh": "WiFi · 5G · 深空通信，全在跑它。", "en": "WiFi, 5G, deep space — all run on it.", "t_in": 149.5, "t_out": 154.0, "punch": false },
    { "zh": "当年：无人问津。", "en": "In 1948: ignored.", "t_in": 157.4, "t_out": 161.8, "punch": false },
    { "zh": "它不管意思，只管搬准。", "en": "No meaning — just faithful delivery.", "t_in": 162.7, "t_out": 167.3, "punch": false },
    { "zh": "信息从此可称重、可搬运、可保存。", "en": "Weigh it. Move it. Keep it.", "t_in": 167.9, "t_out": 173.2, "punch": false },
    { "zh": "一切，始于 1 比特。", "en": "It all starts with one bit.", "t_in": 173.8, "t_out": 179.3, "punch": true }
  ],
  "narration": [
    { "text": "文字、照片、这段视频，都有一个共同的名字——信息。", "t_in": 0.55, "t_out": 4.9 },
    { "text": "可它到底该怎么称重？", "t_in": 5.1, "t_out": 7.5 },
    { "text": "答案藏在一九四八年的论文里。", "t_in": 7.8, "t_out": 12.6 },
    { "text": "作者叫香农。", "t_in": 12.8, "t_out": 15.1 },
    { "text": "香农说，通信只做一件事：把消息从这头，搬到那头。", "t_in": 15.5, "t_out": 20.3 },
    { "text": "至于消息是什么意思，搬运过程一概不问。", "t_in": 20.6, "t_out": 25.4 },
    { "text": "发出端把文字变成信号，线路里跑的是图案，接收端再变回来。", "t_in": 25.7, "t_out": 30.5 },
    { "text": "意义被剥掉了，剩下的东西，才第一次可以被测量。", "t_in": 30.8, "t_out": 35.6 },
    { "text": "测量的单位，叫比特。", "t_in": 38.4, "t_out": 43.4 },
    { "text": "一比特，就是一次抛硬币的答案。", "t_in": 44.0, "t_out": 48.0 },
    { "text": "要么正面，要么反面——两个可能，消灭一个，正好一比特。", "t_in": 48.3, "t_out": 53.3 },
    { "text": "信息的量，就是你消灭不确定性需要问的问题数。", "t_in": 53.6, "t_out": 58.5 },
    { "text": "接着是一条反直觉的规则。", "t_in": 62.2, "t_out": 67.0 },
    { "text": "越猜不到的事，信息量越大。", "t_in": 67.3, "t_out": 72.1 },
    { "text": "太阳明天会升起——这句话信息量接近零。", "t_in": 72.4, "t_out": 77.2 },
    { "text": "彩票的中奖号码——一句顶一万句。", "t_in": 77.5, "t_out": 82.5 },
    { "text": "香农把平均意外程度，起名叫熵。", "t_in": 86.0, "t_out": 91.0 },
    { "text": "可能结果越均匀，熵越大，信息越挤不下。", "t_in": 91.3, "t_out": 96.3 },
    { "text": "熵越大，你就越需要更多的比特，才能把它描述完整。", "t_in": 96.6, "t_out": 101.6 },
    { "text": "这条曲线，后来变成了整个数字世界的地基。", "t_in": 101.9, "t_out": 106.5 },
    { "text": "香农拿英文做了实验。", "t_in": 109.8, "t_out": 114.8 },
    { "text": "按字符统计，每个字母平均只带四点七比特。", "t_in": 115.1, "t_out": 120.1 },
    { "text": "而且将近一半是冗余——你猜得到下一句的大概。", "t_in": 120.4, "t_out": 125.4 },
    { "text": "冗余不是废话，它是抗噪的护甲。", "t_in": 125.7, "t_out": 130.5 },
    { "text": "香农还算出一条管道定律。", "t_in": 133.6, "t_out": 138.6 },
    { "text": "管径加信噪比，决定信息流量的上限。", "t_in": 138.9, "t_out": 143.9 },
    { "text": "只要不超过这条线，错误就能压到任意低。", "t_in": 144.2, "t_out": 149.2 },
    { "text": "WiFi、5G、深空通信，全在这条定律上跑。", "t_in": 149.5, "t_out": 154.3 },
    { "text": "可这篇奠基之作，当年无人问津。", "t_in": 157.4, "t_out": 162.4 },
    { "text": "它不负责意思——只负责把比特搬准。", "t_in": 162.7, "t_out": 167.3 },
    { "text": "从这一刻起，所有信息都能被称重、被搬运、被保存。", "t_in": 167.9, "t_out": 173.5 },
    { "text": "你此刻看到的一切——都是比特在奔跑。", "t_in": 173.8, "t_out": 179.2 }
  ]
}
